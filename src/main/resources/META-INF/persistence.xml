<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">

    <persistence-unit name="chinook" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Aquí irán las entidades, una línea <class> por cada una (a partir del Paso 3) -->
        <class>org.jmiguelra92.modelo.Genero</class>
        <class>org.jmiguelra92.modelo.Artista</class>
        <class>org.jmiguelra92.modelo.Album</class>
        <class>org.jmiguelra92.modelo.Pista</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- La misma conexión que ya conoces de ConexionBD -->
            <property name="jakarta.persistence.jdbc.driver" value="org.mariadb.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mariadb://localhost:3306/chinook"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Hibernate escribe el SQL por ti: con esto lo ves en la consola -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- La base de datos ya existe: Hibernate no debe crear ni modificar tablas -->
            <property name="hibernate.hbm2ddl.auto" value="none"/>
        </properties>
    </persistence-unit>
</persistence>